@page "/examples/climate-risk-dashboard"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject OpenMeteoService OpenMeteo
@inject WriAqueductService WriAqueduct
@inject ClimateMonitorService ClimateMonitor
@inject GadmGeoJsonService GadmGeoJson
@inject RiskCalculationEngine RiskEngine
@inject CompanyProfileService ProfileService
@inject ScenarioComparisonEngine ComparisonEngine
@inject RiskMatrixEngine MatrixEngine
@inject NgfsScenarioService NgfsService
@inject ClimateVarEngine VarEngine
@inject StressTestEngine StressEngine
@inject PortfolioRiskEngine PortfolioEngine

<PageTitle>Iklim Riski Dashboard — Intentum</PageTitle>

<div class="page-card">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <div>
            <h3 style="margin:0;">Iklim Riski Dashboard</h3>
            <p style="font-size:0.8rem;color:#8b949e;margin:0;">Gerçek veri kaynaklı interaktif iklim riski analizi — Open-Meteo, WRI Aqueduct, GADM</p>
        </div>
        <button class="help-btn" @onclick="() => _showHelp = true" title="Nasıl çalışır?">
            <span style="font-size:14px;font-weight:700;">?</span>
        </button>
    </div>
</div>

@if (_showHelp)
{
    <div class="help-overlay" @onclick="() => _showHelp = false">
        <div class="help-dialog" @onclick:stopPropagation>
            <div class="help-dialog-header">
                <span>ℹ️ Nasıl Çalışır? — Metodoloji &amp; Veri Kaynakları</span>
                <button class="help-close" @onclick="() => _showHelp = false">&times;</button>
            </div>
            <div class="help-dialog-body">

                <!-- ==================== RİSK ÇERÇEVESİ ==================== -->
                <div class="help-section">
                    <div class="help-section-title">🎯 Risk Çerçevesi: Risk = Tehlike × Maruziyet × Kırılganlık</div>
                    <p>Bu dashboard, IPCC (Hükümetlerarası İklim Değişikliği Paneli) risk çerçevesini kullanır. İklim riski üç bileşenin çarpımıdır:</p>
                    <ul>
                        <li><strong>Tehlike (Hazard):</strong> İklim modeli ve ölçümler belirler. Aşırı sıcaklık, kuraklık, sel gibi olayların <em>nerede ve ne şiddette</em> olacağı.</li>
                        <li><strong>Maruziyet (Exposure):</strong> Şirketin varlığının nerede, ne kadar ve hangi değerde durduğu (finansal değer).</li>
                        <li><strong>Kırılganlık (Vulnerability):</strong> Tesisin yapısı ve hazırlığı — <em>Hassasiyet (Sensitivity) / Uyum Kapasitesi (Adaptive Capacity)</em> oranı.</li>
                    </ul>
                </div>

                <!-- ==================== VERİ KAYNAKLARI ==================== -->
                <div class="help-section">
                    <div class="help-section-title">🌍 Veri Kaynakları &amp; Kullanım Detayları</div>

                    <!-- WRI Aqueduct -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#38bdf8;font-size:0.75rem;margin-bottom:4px;">💧 WRI Aqueduct (Water Resources Institute)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Dosyalar:</strong> <code>wwwroot/data/wri/country_baseline.csv</code> + <code>country_future.csv</code><br/>
                            <strong>İçerik:</strong> 192 ülke için su stresi (<code>bws/Tot</code>, 0-5 skoru), sel riski, kuraklık riski. Gelecek projeksiyonları SSP senaryolarına göre (SSP1→opt, SSP2→bau, SSP3/5→pes) 2030/2050/2080 yılları için.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>WriAqueductService.GetForCountry(iso3)</code> → <code>WriCountryRisk</code> (baseline su stresi, sel, kuraklık)</li>
                                <li><code>GetFutureScenario(iso3, scenario)</code> → gelecek senaryosuna göre su stresi değişimi</li>
                                <li>Ülke kodu <code>RiskInput.CountryIso3</code>'ten gelir (koordinattan <code>GeoRiskHelper</code> ile türetilir)</li>
                            </ul>
                            <strong>Ürettiği sinyaller:</strong> <code>physical:water_stress</code>, <code>physical:flood</code>, <code>physical:drought</code><br/>
                            <strong>Etkilediği:</strong> Fiziksel risk skoru, su stresi KPI bar'ı, heatmap tehlike ekseni, öneri metinleri
                        </div>
                    </div>

                    <!-- Open-Meteo -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#f59e0b;font-size:0.75rem;margin-bottom:4px;">🌤️ Open-Meteo Climate API (Canlı API)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Kaynak:</strong> <code>https://climate-api.open-meteo.com/v1/climate</code> (canlı istek, local dosya yok)<br/>
                            <strong>İçerik:</strong> Enlem/boylam + model + senaryo + yıl aralığına göre günlük sıcaklık (min/max ortalama), yağış, rüzgar, nem projeksiyonları. Modeller: EC_Earth3P_HR, MPI_ESM1_2_XR vs.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>OpenMeteoService.GetProjectionAsync(lat, lon, model, startYear, endYear)</code> → <code>ClimateProjection</code></li>
                                <li>Harita marker konumu (<code>Lat/Lon</code>) kullanılır — Anadolu'da bir nokta için gerçek koordinatlara dayalı projeksiyon</li>
                                <li>Model verileri ~2050'ye kadar mevcut, daha sonraki yıllar 2050 değerine sabitlenir (clamp)</li>
                            </ul>
                            <strong>Ürettiği sinyaller:</strong> <code>physical:heatwave</code> (sıcaklık max), <code>physical:storm</code> (rüzgar max), yağış değişiminden türetilen kuraklık/sel sinyalleri<br/>
                            <strong>Etkilediği:</strong> Fiziksel risk skoru, sıcaklık trendi, termal histogram, heatmap, termal risk faktörü
                        </div>
                    </div>

                    <!-- GADM -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#22c55e;font-size:0.75rem;margin-bottom:4px;">🗺️ GADM (Global Administrative Areas)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Dosyalar:</strong> <code>wwwroot/data/gadm/gadm41_{ISO3}_{level}.json</code><br/>
                            <strong>İçerik:</strong> Ülke sınırları (Level 0), il/bölge sınırları (Level 1), ilçe sınırları (Level 2 — sadece Türkiye). 10 ülke: TUR, USA, DEU, GBR, FRA, ITA, JPN, BRA, CHN, IND.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li>Harita katmanları: tıklandığında ülke→il→ilçe drill-down (3 seviye breadcrumb)</li>
                                <li><code>echarts-interop.js</code>: <code>_buildOption</code> içinde <code>geo</code> + <code>geoIndex</code> pattern ile render</li>
                                <li>İlçe düzeyinde (Level 2): Türkiye için 929 ilçe sınırı — haritada tıklanan ilçenin adı province name injection ile eklenir</li>
                                <li>WRI verisiyle eşleştirme: <code>GeoRiskHelper.DetectIso3(lat, lon)</code> → GADM polygon içinde nokta var mı kontrolü</li>
                            </ul>
                            <strong>Etkilediği:</strong> Harita render, breadcrumb navigasyonu, ilçe-level risk renklendirmesi
                        </div>
                    </div>

                    <!-- World.json -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#a78bfa;font-size:0.75rem;margin-bottom:4px;">🌐 World.json (ECharts Map Data)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Dosya:</strong> <code>wwwroot/data/world.json</code><br/>
                            <strong>İçerik:</strong> GeoJSON formatında dünya haritası — tüm ülkelerin sınırları, координатları ve isimleri.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>echarts-interop.js</code>'de <code>echarts.registerMap('world', worldData)</code> ile harita kaydı</li>
                                <li>İlk yüklemede tüm dünya gösterilir, ülke tıklamasıyla GADM level 1/2'ye geçiş</li>
                                <li><code>layoutCenter: ['50%', '50%']</code> + <code>layoutSize: '95%'</code> ile otomatik sığdırma</li>
                            </ul>
                            <strong>Etkilediği:</strong> Ana harita görünümü, dünya-genelinde ülke risk renklendirmesi
                        </div>
                    </div>

                    <!-- Baseline Trends -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#ec4899;font-size:0.75rem;margin-bottom:4px;">📈 Baseline Trends (İklim Temel Eğilimleri)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Dosya:</strong> <code>wwwroot/data/climate/baseline_trends.json</code><br/>
                            <strong>İçerik:</strong> Ülke bazında iklim temel eğilimleri — tarihsel sıcaklık, yağış, deniz seviyesi değişimleri.<br/>
                            <strong>Kullanım:</strong> <code>RiskCalculationEngine</code>'de <code>ClimateBaselineTrends</code> olarak yüklenir, <code>RiskAssessment.Baseline</code> alanına doldurulur.<br/>
                            <strong>Etkilediği:</strong> Risk değerlendirme gerekçeleri, trend karşılaştırmaları
                        </div>
                    </div>

                    <!-- ClimateRegionCatalog -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#f97316;font-size:0.75rem;margin-bottom:4px;">🗺️ ClimateRegionCatalog (Bölgesel Profil — Sabit Veri)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Kaynak:</strong> <code>ClimateRegionCatalog.cs</code> (hardcoded, 11 ülke profili + varsayılan)<br/>
                            <strong>İçerik:</strong> Her ülke için: iklim tipi, baskın tehlikeler (Kuraklık/Su Stresi/Taşkın/Sıcaklık), mevsimsellik notları, uyum önerileri (adaptive recommendations).<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>ClimateRegionCatalog.Get(iso3)</code> → <code>ClimateRegionProfile</code></li>
                                <li><code>DetectIso3(lat, lon)</code> → koordinattan ülke kodu tespiti (GADM polygon kontrolü ile)</li>
                                <li>Her analizde otomatik: <code>RiskAssessment.ClimateRegion</code> doldurulur</li>
                            </ul>
                            <strong>Ürettiği:</strong> Baskın tehlike listesi, mevsimsellik notları, bölgesel adaptif öneriler<br/>
                            <strong>Etkilediği:</strong> Öneriler (sadece baskın tehlikelerle eşleşenler eklenir), bölgesel rozet, karar gerekçeleri
                        </div>
                    </div>

                    <!-- GeoRiskHelper -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#06b6d4;font-size:0.75rem;margin-bottom:4px;">📍 GeoRiskHelper (Coğrafi Analiz)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Kaynak:</strong> <code>GeoRiskHelper.cs</code> (hesaplama mantığı)<br/>
                            <strong>İçerik:</strong> Kıyıya uzaklık, kıyı olup olmadığı, efektif deniz seviyesi yüksekliği, coğrafi not.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>GetCoastalInfo(lat, lon)</code> → <code>(isCoastal, distanceKm, note)</code></li>
                                <li>Kıyıya 25km'den yakınsa <code>isCoastal = true</code>, değilse <code>note = "Denize kıyısı yok"</code></li>
                                <li><code>GetEffectiveSeaLevel(seaLevelRise, distanceKm)</code> → iç bölgelerde deniz seviyesi etkisi sıfırlanır</li>
                                <li>İç bölgelerde <code>effectiveSea = 0m</code> — deniz riski hesaba katılmaz</li>
                            </ul>
                            <strong>Etkilediği:</strong> Kıyı/iç bölge rozeti, <code>physical:sea_level</code> sinyali, heatmap deniz seviyesi ekseni, öneri metinleri
                        </div>
                    </div>

                    <!-- DataSufficiency -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#ef4444;font-size:0.75rem;margin-bottom:4px;">📊 DataSufficiency (Veri Yeterlilik Katmanı)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Kaynak:</strong> <code>DataSufficiency.cs</code> (hesaplama mantığı)<br/>
                            <strong>İçerik:</strong> Her analizde 3 kaynağın mevcudiyetini kontrol eder: Open-Meteo proje verisi, WRI su stresi, şirket profili.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>DataSufficiency.Evaluate(hasProjection, hasWri, hasCompanyProfile)</code> → <code>DataConfidenceResult</code></li>
                                <li>Skor: tüm kaynaklar varsa 1.0, eksikse düşer (0.25'er azalma)</li>
                                <li><code>RiskAssessment.DataConfidence</code>, <code>MissingDataSources</code>, <code>IsRegionalEstimate</code> doldurulur</li>
                            </ul>
                            <strong>Etkilediği:</strong> Karar akışı (DataConfidence &lt; 0.75 → ALLOW yerine REVIEW), eksik veri gerekçeleri, Dashboard Veri Yeterlilik rozeti
                        </div>
                    </div>

                    <!-- Company Profile -->
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;margin-bottom:8px;">
                        <div style="font-weight:700;color:#8b5cf6;font-size:0.75rem;margin-bottom:4px;">🏢 Şirket Profilleri (Finansal Veri)</div>
                        <div style="font-size:0.65rem;color:#94a3b8;line-height:1.5;">
                            <strong>Kaynak:</strong> <code>CompanyProfileService</code> (seed: 3 hazır şirket) + <code>CompanyProfileImporter</code> (CSV yükleme)<br/>
                            <strong>İçerik:</strong> Şirket adı, sektörü, konumu, gelir/gider kalemleri (hassasiyet + uyum kapasitesi ile), kırılganlık skoru.<br/>
                            <strong>Kullanım:</strong>
                            <ul style="margin:2px 0;padding-left:16px;">
                                <li><code>CompanyProfileService.Get(id)</code> → seçili şirket profili</li>
                                <li><code>FinancialImpactEngine.Calculate(profile, physical, transition, signals)</code> → <code>FinancialImpact</code></li>
                                <li>Her gelir/gider kalemi: <code>Sensitivity × AdaptiveCapacity × RiskSkoru = ParasalEtki</code></li>
                                <li>Toplam finansal etki → karar sıkılaştırması (net kayıp > 10M → REVIEW, > 25M → REJECT)</li>
                                <li>CSV ile özel şirket verisi yüklenebilir (<code>templates/sirket_sablonu.csv</code>)</li>
                            </ul>
                            <strong>Ürettiği sinyaller:</strong> <code>economic:revenue_at_risk</code>, <code>economic:operational_expenses</code>, <code>economic:cost_of_goods</code>, <code>economic:capital_expenditure</code>, <code>economic:impact</code><br/>
                            <strong>Etkilediği:</strong> Finansal etki kartı, gelir kaybı sinyalleri, karar sıkılaştırması, önerilerde finansal tedbirler
                        </div>
                    </div>
                </div>

                <!-- ==================== SİNYAL AKIŞI ==================== -->
                <div class="help-section">
                    <div class="help-section-title">⚡ Sinyal Akışı: Veri → BehaviorSpace → Niyet → Karar</div>
                    <p>Her veri kaynağı belirli sinyalleri BehaviorSpace'e yazar. IntentModel bu sinyallerden niyeti çıkarır:</p>
                    <div style="background:#0f172a;border:1px solid #1e3a5f;border-radius:8px;padding:10px;font-size:0.65rem;color:#94a3b8;line-height:1.6;">
                        <code style="color:#38bdf8;">Open-Meteo</code> → <code style="color:#f59e0b;">physical:heatwave</code>, <code style="color:#f59e0b;">physical:storm</code><br/>
                        <code style="color:#38bdf8;">WRI Aqueduct</code> → <code style="color:#f59e0b;">physical:water_stress</code>, <code style="color:#f59e0b;">physical:flood</code>, <code style="color:#f59e0b;">physical:drought</code><br/>
                        <code style="color:#38bdf8;">GeoRiskHelper</code> → <code style="color:#f59e0b;">physical:sea_level</code><br/>
                        <code style="color:#38bdf8;">RiskInput (kullanıcı)</code> → <code style="color:#f59e0b;">transition:policy</code>, <code style="color:#f59e0b;">transition:market</code>, <code style="color:#f59e0b;">transition:technology</code>, <code style="color:#f59e0b;">transition:reputation</code><br/>
                        <code style="color:#38bdf8;">CompanyProfile</code> → <code style="color:#f59e0b;">economic:revenue_at_risk</code>, <code style="color:#f59e0b;">economic:operational_expenses</code>, <code style="color:#f59e0b;">economic:cost_of_goods</code>, <code style="color:#f59e0b;">economic:capital_expenditure</code>, <code style="color:#f59e0b;">economic:impact</code><br/>
                        <code style="color:#38bdf8;">DataSufficiency</code> → <code style="color:#f59e0b;">signal:missing_data</code>, <code style="color:#f59e0b;">signal:regional_estimate</code>
                        <br/><br/>
                        <span style="color:#22c55e;">→ IntentModel.Infer(space) → </span><span style="color:#ef4444;">Niyet (Kritik/Yüksek/Orta/Düşük) + Güven</span><br/>
                        <span style="color:#22c55e;">→ IntentPolicyEngine.Evaluate(intent, policy) → </span><span style="color:#ef4444;">ALLOW / REVIEW / REJECT</span>
                    </div>
                </div>

                <!-- ==================== NASIL ÇALIŞTIRILIYOR ==================== -->
                <div class="help-section">
                    <div class="help-section-title">⚙️ Analiz Akışı (Adım Adım)</div>
                    <ol>
                        <li><strong>Girdi:</strong> Sol panelden senaryo, sektör, zaman dilimi, parametreler (sıcaklık, yağış, deniz, karbon fiyatı), lokasyon ve şirket profili ayarlanır.</li>
                        <li><strong>Veri toplama:</strong> Open-Meteo projeksiyonu, WRI su stresi, GeoRiskHelper kıyı analizi, şirket profili paralel olarak çekilir.</li>
                        <li><strong>Veri yeterlilik:</strong> Kaynakların mevcudiyeti kontrol edilir — eksik veri varsa <code>DataConfidence</code> düşer ve karar REVIEW'e çekilir.</li>
                        <li><strong>Risk hesaplama:</strong> Fiziksel risk (iklim verisi + WRI + slider) ve geçiş riski (karbon fiyatı + senaryo + sektör) ağırlıklı olarak hesaplanır.</li>
                        <li><strong>BehaviorSpace:</strong> Tüm sinyaller <code>Observe("actor", "action")</code> ile BehaviorSpace'e yazılır. Örn: <code>physical:water_stress</code>, <code>economic:revenue_at_risk</code>.</li>
                        <li><strong>Niyet çıkarma:</strong> IntentModel sinyallerden toplam ağırlık hesaplar, ortalamayı niyete bağlar (Kritik/Yüksek/Orta/Düşük).</li>
                        <li><strong>Politika kararı:</strong> IntentPolicy niyet + güven seviyesine göre karar üretir. Veri yetersizse ALLOW → REVIEW sıkılaştırması uygulanır.</li>
                        <li><strong>Finansal bağlantı:</strong> Şirket profili varsa finansal maruziyet hesaplanır. Büyük kayıp (>10M TL) kararı bir kademe sıkılaştırır.</li>
                        <li><strong>Öneriler:</strong> Karar, risk seviyesi, bölgesel profil ve baskın tehlikelere göre koşullu öneriler üretilir.</li>
                    </ol>
                </div>

                <!-- ==================== DASHBOARD OKUMA ==================== -->
                <div class="help-section">
                    <div class="help-section-title">📊 Dashboard'ı Okuma</div>
                    <ul>
                        <li><strong>KPI bar:</strong> Fiziksel risk, geçiş riski, su stresi, MDP etkisi ve nihai politika kararı.</li>
                        <li><strong>Harita:</strong> Ülke tıklayın → il/bölge. Marker = seçili şirket konumu. İlçe düzeyine kadar inilebilir.</li>
                        <li><strong>İklim Risk Matrix (heatmap):</strong> Tehlike × Varlık ve Tehlike × Senaryo — bileşik riskin hücre hücre görünümü.</li>
                        <li><strong>Sinyal Dağılımı:</strong> Her sinyalin ağırlığı gerçek veriden hesaplanır (WRI skoru, şirket geliri, fiziksel risk skoru).</li>
                        <li><strong>Finansal Etki:</strong> Fiziksel/geçiş riskinin şirket kalemlerine parasal yansıması.</li>
                        <li><strong>Politika Kararı:</strong> Intentum niyeti, güveni, Veri Yeterlilik rozeti, bölgesel profil, nedenleri, koşullu öneriler ve sinyaller.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@if (_assessment == null && !_running)
{
    <div class="page-card" style="text-align:center;padding:3rem;">
        <p style="font-size:1rem;color:#8b949e;">Sol panelden parametreleri ayarlayıp <strong>Analiz Et</strong> butonuna tıklayın</p>
    </div>
}

@if (_assessment != null)
{
    <div class="climate-kpi-bar">
        <div class="climate-kpi-item" style="border-left-color:#ef4444;" title="Genel risk skoru: Fiziksel risk × 0,6 + Geçiş riski × 0,4 ağırlıklı ortalaması. Tüm risk bileşenlerinin tek skorda birleşimi.">
            <div class="kpi-label" style="color:#ef4444;">Genel Risk</div>
            <div class="kpi-value">@_assessment.OverallRisk.ToString("F2")</div>
            <div class="kpi-sub">@GetRiskLabel(_assessment.OverallRisk)</div>
        </div>
        <div class="climate-kpi-item" style="border-left-color:#ff9800;" title="İklimsel doğa olaylarının şiddeti ve sıklığı: sıcaklık, yağış, rüzgar, sel, kuraklık. Open-Meteo + WRI verilerinden hesaplanır.">
            <div class="kpi-label" style="color:#ff9800;">Fiziksel Risk</div>
            <div class="kpi-value">@_assessment.PhysicalRisk.ToString("F2")</div>
            <div class="kpi-sub">@GetRiskLabel(_assessment.PhysicalRisk)</div>
        </div>
        <div class="climate-kpi-item" style="border-left-color:#9c27b0;" title="Ekonomik geçiş süreci riski: karbon fiyatı, regülasyon, teknoloji değişimi, piyasa baskısı. Kullanıcı parametrelerinden hesaplanır.">
            <div class="kpi-label" style="color:#9c27b0;">Gecis Riski</div>
            <div class="kpi-value">@_assessment.TransitionRisk.ToString("F2")</div>
            <div class="kpi-sub">@GetRiskLabel(_assessment.TransitionRisk)</div>
        </div>
        <div class="climate-kpi-item" style="border-left-color:#f44336;" title="WRI Aqueduct verisine göre bölgenin su talebinin su kaynaklarına oranı (0-5). 3+ = yüksek, 4+ = çok yüksek stres.">
            <div class="kpi-label" style="color:#f44336;">Su Stresi</div>
            <div class="kpi-value">@_assessment.WaterStress.ToString("F1")</div>
            <div class="kpi-sub">@_assessment.WaterStressLabel</div>
        </div>
        <div class="climate-kpi-item" style="border-left-color:#4caf50;" title="İklim riskinin şirkete parasal etkisi: MDP (Marka Değeri Kaybı) kaybı, milyon dolar cinsinden. Şirket profili varsa hesaplanır.">
            <div class="kpi-label" style="color:#4caf50;">MDP Etkisi</div>
            <div class="kpi-value">-$@_assessment.EconomicImpact.MdpLoss.ToString("F1")M</div>
            <div class="kpi-sub">@_input.Horizon Tahmini</div>
        </div>
        <div class="climate-kpi-item" style="border-left-color:#2196f3;" title="Intentum niyet analizi sonucu: ALLOW (düşük risk, standart izleme), REVIEW (orta-yüksek risk, detaylı değerlendirme), REJECT (kritik risk, acil eylem).">
            <div class="kpi-label" style="color:#2196f3;">Politika</div>
            <div class="kpi-value">@GetPolicyDecision()</div>
            <div class="kpi-sub">Intentum Karari</div>
        </div>
    </div>
}

<div class="climate-dashboard">
    <!-- Left: Controls -->
    <div class="climate-controls">
        <label>Senaryo</label>
        <select @bind="_input.Scenario">
            <option value="SSP1-2.6">SSP1-2.6 (Surdurulebilir)</option>
            <option value="SSP2-4.5">SSP2-4.5 (Orta Yol)</option>
            <option value="SSP3-7.0">SSP3-7.0 (Bolgesel Cekisme)</option>
            <option value="SSP5-8.5">SSP5-8.5 (Fosil Yakit)</option>
        </select>

        <label>NGFS Senaryo <span style="color:#94a3b8;font-weight:normal;">(opsiyonel)</span></label>
        <select @bind="_input.NgfsScenarioId">
            <option value="">Yok</option>
            <option value="n nz2050">Net Zero 2050 (Orderly, 1.5°C)</option>
            <option value="n below2c">Below 2°C (Orderly, 1.7°C)</option>
            <option value="n delayed">Delayed Transition (Disorderly, 1.5°C)</option>
            <option value="n ndcs">NDCs (Disorderly, 1.8°C)</option>
            <option value="n fragmented">Fragmented World (Disorderly, 2.3°C)</option>
            <option value="n currpol">Current Policies (HotHouse, 3°C+)</option>
            <option value="n lowdemand">Low Demand (Orderly, 1.5°C)</option>
        </select>

        <label>Sektor</label>
        <select @bind="_input.Sector">
            <option value="Enerji">Enerji</option>
            <option value="Tarim">Tarim & Gida</option>
            <option value="Emlak">Emlak & Insaat</option>
            <option value="Finans">Finans & Sigorta</option>
            <option value="Turizm">Turizm & Konaklama</option>
            <option value="Sanayi">Uretim & Sanayi</option>
        </select>

        <label>Zaman Dilimi</label>
        <div class="climate-time-btns">
            <div class="climate-time-btn @(_input.Horizon == 2030 ? "active" : "")" @onclick="() => _input.Horizon = 2030">2030</div>
            <div class="climate-time-btn @(_input.Horizon == 2050 ? "active" : "")" @onclick="() => _input.Horizon = 2050">2050</div>
            <div class="climate-time-btn @(_input.Horizon == 2100 ? "active" : "")" @onclick="() => _input.Horizon = 2100">2100</div>
        </div>

        <label>Parametreler</label>
        <div class="climate-slider-group">
            <div class="slider-header"><span>Sicaklik Artisi</span><span>@(_tempAnomaly.ToString("F1")) C</span></div>
            <input type="range" min="0" max="60" @bind="_tempSlider" @bind:after="UpdateTempAnomaly" style="accent-color:#ff9800;">
        </div>
        <div class="climate-slider-group">
            <div class="slider-header"><span>Yagis Degisimi</span><span>@(_precipChange.ToString("F0"))%</span></div>
            <input type="range" min="-50" max="50" @bind="_precipSlider" @bind:after="UpdatePrecipChange" style="accent-color:#2196f3;">
        </div>
        <div class="climate-slider-group">
            <div class="slider-header"><span>Deniz Seviyesi</span><span>+@(_seaLevelRise.ToString("F1"))m</span></div>
            <input type="range" min="0" max="100" @bind="_seaSlider" @bind:after="UpdateSeaLevel" style="accent-color:#00bcd4;">
        </div>
        <div class="climate-slider-group">
            <div class="slider-header"><span>Karbon Fiyati</span><span>EUR@(_carbonPrice)/tCO2</span></div>
            <input type="range" min="0" max="200" @bind="_carbonSlider" @bind:after="UpdateCarbonPrice" style="accent-color:#9c27b0;">
        </div>

        <label style="margin-top:0.5rem;">Lokasyon</label>
        <input type="number" step="0.01" placeholder="Enlem" @bind="_input.Latitude" style="display:inline-block;width:48%;">
        <input type="number" step="0.01" placeholder="Boylam" @bind="_input.Longitude" style="display:inline-block;width:48%;margin-left:4%;">
        <input type="text" placeholder="Lokasyon Adi" @bind="_input.LocationName">

        <label>Yaricap</label>
        <div class="climate-radius-btns">
            <div class="climate-radius-btn @(_input.RadiusKm == 10 ? "active" : "")" @onclick="() => _input.RadiusKm = 10">10 km</div>
            <div class="climate-radius-btn @(_input.RadiusKm == 25 ? "active" : "")" @onclick="() => _input.RadiusKm = 25">25 km</div>
            <div class="climate-radius-btn @(_input.RadiusKm == 50 ? "active" : "")" @onclick="() => _input.RadiusKm = 50">50 km</div>
        </div>

        <button class="climate-analyze-btn" @onclick="RunAnalysis" disabled="@_running">
            @(_running ? "Analiz Ediliyor..." : "Analiz Et")
        </button>

        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px;">
            <span style="font-size:0.65rem;color:#8b949e;text-transform:uppercase;letter-spacing:0.5px;">📥 Şirket İçe Aktar</span>
            <a href="templates/sirket_sablonu.csv" download style="font-size:0.62rem;color:#58a6ff;text-decoration:none;white-space:nowrap;">
                ⬇️ Şablon (CSV)
            </a>
        </div>
        <div class="climate-upload-area" @onclick="TriggerFileUpload">
            Dosya Yukle (CSV — yeni şirket ekler)
        </div>
        <input id="climate-file-input" type="file" accept=".csv" style="display:none;" @ref="_fileInputRef" @onchange="OnFileInputChange" />
        @if (!string.IsNullOrEmpty(_importMessage))
        {
            <div style="font-size:0.62rem;margin-top:6px;padding:6px 8px;border-radius:4px;line-height:1.4;@(_importError ? "background:rgba(248,81,73,0.1);border:1px solid rgba(248,81,73,0.3);color:#f85149;" : "background:rgba(63,185,80,0.1);border:1px solid rgba(63,185,80,0.3);color:#3fb950;")">
                @_importMessage
            </div>
        }

        <!-- Şirket Profili -->
        <div class="control-group">
            <label class="control-label">🏢 Şirket Profili</label>
            <div class="button-group">
                @foreach (var p in _profiles)
                {
                    <button class="btn btn-profile @(_input.CompanyProfileId == p.Id ? "active" : "")"
                            @onclick="() => SelectProfile(p.Id)">
                        @p.Name
                    </button>
                }
                <button class="btn btn-profile" @onclick="OpenNewProfileDrawer" style="border-style:dashed;color:#58a6ff;">+ Yeni</button>
            </div>
            @if (_selectedProfile != null)
            {
                <div class="selected-profile-info">
                    <span>@_selectedProfile.Sector | @_selectedProfile.LocationName</span>
                    <button class="btn-edit-profile" @onclick="OpenDrawer">✏️ Düzenle</button>
                </div>
            }
        </div>
    </div>

    <!-- Center: Map -->
    <div class="climate-workspace">
    <div class="climate-map-container">
        <div class="map-header">
            @if (_mapLevel >= 1)
            {
                <span style="cursor:pointer;color:#60a5fa;font-weight:600;" @onclick="MapBackToWorld">← Dünya</span>
                <span style="margin:0 4px;color:#475569;">/</span>
                <span style="color:#e2e8f0;">@_currentCountryName</span>
                @if (_mapLevel >= 2 && !string.IsNullOrEmpty(_currentProvinceName))
                {
                    <span style="margin:0 4px;color:#475569;">/</span>
                    <span style="color:#e2e8f0;">@_currentProvinceName (ilçeler)</span>
                }
            }
            else
            {
                <span style="color:#e2e8f0;">Interaktif Risk Haritası</span>
            }
            @if (_selectedProfile != null)
            {
                <span style="margin-left:auto;font-size:0.7rem;color:#94a3b8;">
                    📍 @_selectedProfile.Name — @_selectedProfile.LocationName
                </span>
            }
        </div>
        <div id="climate-geo-map" style="width:100%;height:100%;min-height:450px;padding-top:35px;"></div>
        <div class="map-legend">
            <div style="color:#94a3b8;font-size:0.65rem;margin-bottom:4px;">Risk Seviyesi</div>
            <div class="legend-items">
                <div class="legend-item"><div class="legend-color" style="background:#22c55e;"></div><span>Düşük</span></div>
                <div class="legend-item"><div class="legend-color" style="background:#f59e0b;"></div><span>Orta</span></div>
                <div class="legend-item"><div class="legend-color" style="background:#ef4444;"></div><span>Yüksek</span></div>
                <div class="legend-item"><div class="legend-color" style="background:#991b1b;"></div><span>Çok Yüksek</span></div>
            </div>
        </div>
        <div class="map-controls">
            <button @onclick="ZoomIn" title="Yakınlaş">+</button>
            <button @onclick="ZoomOut" title="Uzaklaş">−</button>
            <button @onclick="ResetZoom" title="Sıfırla">⌂</button>
        </div>
    </div>

    <!-- Seçili Lokasyon Detayı -->
    @if (!string.IsNullOrEmpty(_selectedProvince))
    {
        var isCompanyLocation = _selectedProfile != null && string.Equals(_selectedProfile.LocationName, _selectedProvince, StringComparison.OrdinalIgnoreCase);
        var companyProvince = _selectedProfile?.LocationName;
        <div class="climate-chart-card span-2">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                <span style="font-size:0.72rem;text-transform:uppercase;color:#8b949e;letter-spacing:0.5px;">
                    📍 @_selectedProvince — İl Risk Profili
                    @if (isCompanyLocation)
                    {
                        <span style="display:inline-block;margin-left:8px;padding:2px 6px;border-radius:4px;background:rgba(63,185,80,0.15);color:#3fb950;font-size:0.6rem;text-transform:none;">Şirket Lokasyonu</span>
                    }
                </span>
                @if (_selectedProvinceRisks.Count > 0)
                {
                    <span class="intent-badge" style="background:rgba(255,152,0,0.15);color:#ff9800;">En yüksek: @GetRiskLevel5(_selectedProvinceRisks.Max(r => r.Score))</span>
                }
            </div>

            @foreach (var (name, score) in _selectedProvinceRisks)
            {
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                    <span style="width:90px;font-size:0.62rem;color:#94a3b8;white-space:nowrap;">@name</span>
                    <div style="flex:1;height:9px;background:#1e293b;border-radius:5px;overflow:hidden;">
                        <div style="height:100%;width:@((score / 5.0 * 100))%;background:@GetRiskColor(score);border-radius:5px;"></div>
                    </div>
                    <span style="width:34px;text-align:right;font-size:0.68rem;font-weight:700;color:@GetRiskColor(score);">@score.ToString("F1")</span>
                    <span style="width:56px;font-size:0.58rem;color:@GetRiskColor(score);">@GetRiskLevel5(score)</span>
                </div>
            }

            <div style="font-size:0.68rem;color:#cbd5e1;line-height:1.55;margin-top:8px;">
                @if (_selectedProfile != null)
                {
                    if (isCompanyLocation)
                    {
                        <text>
                            <strong>@_selectedProfile.Name</strong> (@_selectedProfile.Sector sektörü) <strong>@_selectedProfile.LocationName</strong>'de kurulu.
                            Bu ilin risk profili yukarıda — fiili analiz sonucu: <strong>@GetPolicyDecision()</strong> (fiziksel %@(_assessment?.PhysicalRisk * 100):F0, geçiş %@(_assessment?.TransitionRisk * 100):F0).
                        </text>
                    }
                    else
                    {
                        <text>
                            <span style="color:#fbbf24;">Senaryo:</span> <strong>@_selectedProfile.Name</strong> şu an <strong>@_selectedProfile.LocationName</strong>'de. Bu tesis <strong>@_selectedProvince</strong>'de olsaydı,
                            su stresi @_selectedProvinceRisks.FirstOrDefault(r => r.Name == "Su Stresi").Score.ToString("F1")/5 seviyesine çıkar/bu bölgedeki iklim tehlikeleriyle karşı karşıya kalırdı.
                            (Mevcut İzmir analizi: <strong>@GetPolicyDecision()</strong>)
                        </text>
                    }
                }
                else
                {
                    <text>@_selectedProvince ilinin çoklu iklim risk profili yukarıda gösterilmektedir.</text>
                }
            </div>
        </div>
    }

    <!-- Grid: Cards -->
    <div class="climate-charts-panel">
        <div class="climate-chart-card">
            <div class="chart-title" data-tip="Fiziksel, geçiş ve ekonomik risk bileşenlerinin göreli dağılımını pasta grafikle gösterir. Fiziksel risk iklim olaylarından, geçiş riski karbon/regülasyondan, ekonomi ise toplam maliyet etkisinden gelir.">Risk Dagilimi</div>
            <div id="climate-risk-pie" class="chart-container" style="height:170px;"></div>
        </div>

        <div class="climate-chart-card">
            <div class="chart-title" data-tip="İklim riskinin şirkete para cinsinden etkisi: MDP kaybı, yatırım (CAPEX) artışı, sigorta maliyeti, borçlanma maliyeti ve operasyonel maliyetler. Değerler milyon dolar cinsindendir.">Ekonomik Etki (Milyon $)</div>
            <div id="climate-economic-bar" class="chart-container" style="height:170px;"></div>
        </div>

        <div class="climate-chart-card">
            <div class="chart-title" data-tip="Seçili şirket için farklı iklim senaryolarındaki (SSP1-2.6 … SSP5-8.5) fiziksel ve geçiş riskini karşılaştırır. Her senaryo paralel hesaplanır; hangi senaryoda riskin nasıl değiştiğini gösterir.">Senaryo Karsilastirma</div>
            <div id="climate-scenario-line" class="chart-container" style="height:170px;"></div>
        </div>

        @if (_ngfsComparison != null && _ngfsComparison.Count > 0)
        {
            <div class="climate-chart-card">
                <div class="chart-title" data-tip="NGFS Phase 5 senaryolarına göre GSYİH değişimi, karbon fiyatı ve sıcaklık artışını gösterir. Seçili ülke ve yıl için tüm NGFS senaryolarını karşılaştırır.">🌍 NGFS Makro Karşılaştırma</div>
                <div id="climate-ngfs-comparison" class="chart-container" style="height:190px;"></div>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                    @foreach (var s in _ngfsComparison.Where(s => s.GdpChange is not null))
                    {
                        var scenarioDef = NgfsScenarios.GetByName(s.Scenario);
                        <div style="flex:1 1 120px;background:#1e293b;border:1px solid @(scenarioDef?.Category == "HotHouse" ? "#ef4444" : scenarioDef?.Category == "Disorderly" ? "#f59e0b" : "#22c55e");border-radius:6px;padding:6px 8px;font-size:0.58rem;">
                            <div style="font-weight:600;color:#e2e8f0;margin-bottom:2px;">@s.Scenario</div>
                            <div style="color:#94a3b8;">@((scenarioDef?.WarmingLevel ?? 0).ToString("F1"))°C · @scenarioDef?.Category</div>
                            <div style="color:@(s.GdpChange >= 0 ? "#22c55e" : "#ef4444");font-weight:600;">GSYİH: @(((s.GdpChange ?? 0) >= 0 ? "+" : "") + (s.GdpChange ?? 0).ToString("F1"))%</div>
                            <div style="color:#60a5fa;">Karbon: $@(s.CarbonPrice?.ToString("F0") ?? "—")/tCO₂</div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_varResult != null && _varResult.LossDistribution.Count > 0)
        {
            <div class="climate-chart-card">
                <div class="chart-title" data-tip="NGFS senaryolarına göre şirketin beklenen iklim kayıplarını gösterir. VaR95, %95 güvenle bu kaybın aşılmayacağını; CVaR95 ise aşıldığında ortalama kaybı temsil eder.">💰 Climate VaR</div>
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px;">
                    <div class="climate-var-metric">
                        <div class="label">VaR95</div>
                        <div class="value negative">@(_varResult.VaR95.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)) TL</div>
                    </div>
                    <div class="climate-var-metric">
                        <div class="label">VaR99</div>
                        <div class="value negative">@(_varResult.VaR99.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)) TL</div>
                    </div>
                    <div class="climate-var-metric">
                        <div class="label">CVaR95</div>
                        <div class="value negative">@(_varResult.CVaR95.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)) TL</div>
                    </div>
                    <div class="climate-var-metric">
                        <div class="label">Beklenen Kayıp</div>
                        <div class="value @(_varResult.ExpectedLoss >= 0 ? "positive" : "negative")">@(_varResult.ExpectedLoss.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)) TL</div>
                    </div>
                </div>
                <div id="climate-var-bar" class="chart-container" style="height:180px;"></div>
            </div>
        }

        <div class="climate-chart-card">
            <div class="chart-title" data-tip="Risk faktörlerini değiştirerek finansal etkinin nasıl değiştiğini test edin.">🔬 Stres Testi</div>

            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:10px;">
                <div class="climate-stress-slider"><label>Sıcaklık</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.TemperatureMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.TemperatureMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Yağış</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.PrecipitationMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.PrecipitationMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Deniz Seviyesi</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.SeaLevelMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.SeaLevelMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Su Stresi</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.WaterStressMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.WaterStressMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Karbon Fiyatı</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.CarbonPriceMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.CarbonPriceMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Rüzgar</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.WindSpeedMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.WindSpeedMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Fiziksel Risk</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.PhysicalRiskMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.PhysicalRiskMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
                <div class="climate-stress-slider"><label>Geçiş Riski</label><input type="range" min="0.5" max="3.0" step="0.1" @bind="_stressFactors.TransitionRiskMultiplier" @bind:event="oninput" /><span class="mult-value">@(_stressFactors.TransitionRiskMultiplier.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))×</span></div>
            </div>

            <button class="climate-btn" @onclick="RunStressTest" disabled="@(_stressRunning || _assessment == null)">
                @(_stressRunning ? "Hesaplanıyor..." : "Stres Testi Çalıştır")
            </button>

            @if (_stressResult != null)
            {
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px;">
                    <div class="climate-var-metric">
                        <div class="label">Fiziksel Risk Değişimi</div>
                        <div class="value @(_stressResult.Delta.PhysicalRiskDelta >= 0 ? "negative" : "positive")">@(_stressResult.Delta.PhysicalRiskDelta >= 0 ? "+" : "")@(_stressResult.Delta.PhysicalRiskDelta.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))</div>
                    </div>
                    <div class="climate-var-metric">
                        <div class="label">Geçiş Riski Değişimi</div>
                        <div class="value @(_stressResult.Delta.TransitionRiskDelta >= 0 ? "negative" : "positive")">@(_stressResult.Delta.TransitionRiskDelta >= 0 ? "+" : "")@(_stressResult.Delta.TransitionRiskDelta.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))</div>
                    </div>
                    <div class="climate-var-metric">
                        <div class="label">Karar Değişimi</div>
                        <div class="value">@_stressResult.Delta.DecisionChange</div>
                    </div>
                </div>

                @if (_stressResult.SensitivityRanking.Count > 0)
                {
                    <div style="margin-top:10px;">
                        <div style="font-size:0.62rem;color:#94a3b8;margin-bottom:4px;">Duyarlılık Sıralaması</div>
                        @foreach (var s in _stressResult.SensitivityRanking)
                        {
                            <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                                <span style="width:90px;font-size:0.6rem;color:#94a3b8;">@s.FactorName</span>
                                <div style="flex:1;height:5px;background:#1e293b;border-radius:3px;overflow:hidden;">
                                    <div style="height:100%;width:@(s.SensitivityScore * 100)%;background:@(s.Risk == "Yüksek" ? "#ef4444" : s.Risk == "Orta" ? "#f59e0b" : "#22c55e");border-radius:3px;"></div>
                                </div>
                                <span style="width:40px;font-size:0.55rem;color:@(s.Risk == "Yüksek" ? "#ef4444" : s.Risk == "Orta" ? "#f59e0b" : "#22c55e");">@s.Risk</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @if (_profiles.Count > 0)
        {
            <div class="climate-chart-card">
                <div class="chart-title" data-tip="Seçili şirketlerin risk durumunu karşılaştırır, portföy toplam riski ve çeşitlendirme avantajını hesaplar.">🏢 Portföy Risk Görünümü</div>

                <div class="climate-portfolio-check">
                    @foreach (var p in _profiles)
                    {
                        <label>
                            <input type="checkbox" checked="@(_selectedCompanyIds.Contains(p.Id))" @onchange="e => ToggleCompany(p.Id, e)" />
                            @p.Name
                        </label>
                    }
                </div>

                <button class="climate-btn" @onclick="RunPortfolioAnalysis" disabled="@_portfolioRunning">
                    @(_portfolioRunning ? "Hesaplanıyor..." : "Portföy Analizi Çalıştır")
                </button>

                @if (_portfolioResult != null)
                {
                    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0;">
                        <div class="climate-var-metric">
                            <div class="label">Toplam Ciro</div>
                            <div class="value">@(_portfolioResult.TotalRevenue.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)) TL</div>
                        </div>
                        <div class="climate-var-metric">
                            <div class="label">Risk Altında</div>
                            <div class="value negative">@(_portfolioResult.TotalAtRisk.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)) TL</div>
                        </div>
                        <div class="climate-var-metric">
                            <div class="label">Konsantrasyon</div>
                            <div class="value">@(_portfolioResult.ConcentrationRisk.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%</div>
                        </div>
                        <div class="climate-var-metric">
                            <div class="label">Portföy Kararı</div>
                            <div class="value" style="color:@(_portfolioResult.PortfolioDecision == "ALLOW" ? "#22c55e" : "#f59e0b")">@_portfolioResult.PortfolioDecision</div>
                        </div>
                    </div>

                    <table class="climate-portfolio-table">
                        <thead><tr><th>Şirket</th><th>Sektör</th><th>Risk Skoru</th><th>Karar</th><th>Ciroda Risk</th></tr></thead>
                        <tbody>
                            @foreach (var c in _portfolioResult.RiskRanking)
                            {
                                <tr class="@(c.Decision == "REJECT" ? "climate-portfolio-row-reject" : c.Decision == "REVIEW" ? "climate-portfolio-row-review" : "")">
                                    <td>@c.Company.Name</td>
                                    <td>@c.Company.Sector</td>
                                    <td style="color:@(c.RiskScore >= 0.6 ? "#ef4444" : c.RiskScore >= 0.4 ? "#f59e0b" : "#22c55e")">@c.RiskScore.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                                    <td>@c.Decision</td>
                                    <td>@c.RevenueAtRisk.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) TL</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        @if (_assessment != null)
        {
            <div class="climate-chart-card">
                <div class="chart-title" data-tip="WRI Aqueduct'tan gelen ülke bazlı su stresi indeksi (0-5 ölçeği). Senaryo ve zaman dilimine göre güncellenir. Yüksek değer, tatlı su kıtlığı riskinin arttığını gösterir.">Su Stresi Endeksi (WRI)</div>
                <div id="climate-water-gauge" class="chart-container" style="height:150px;"></div>
                <div style="text-align:center;font-size:0.62rem;color:#94a3b8;margin-top:2px;">@_assessment.WaterStress.ToString("F1") / 5 — @_assessment.WaterStressLabel</div>
            </div>

            <div class="climate-chart-card">
                <div class="chart-title" data-tip="İklim riskini oluşturan bireysel faktörlerin (sıcaklık, yağış, rüzgar, deniz, su stresi, sel, kuraklık) katkı yüzdeleri. Her faktörün kaynağı -open-meteo, slider, wri-aqueduct- ayrıca gösterilir.">Risk Faktorleri</div>
                @foreach (var factor in _assessment.RiskFactors)
                {
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;font-size:0.62rem;">
                        <span style="width:96px;color:#94a3b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@factor.Name">@factor.Name</span>
                        <div style="flex:1;height:6px;background:#1e293b;border-radius:3px;overflow:hidden;">
                            <div style="height:100%;width:@(factor.Score * 100)%;background:@factor.Color;border-radius:3px;"></div>
                        </div>
                        <span style="width:32px;text-align:right;color:@factor.Color;font-weight:600;">@(Math.Round(factor.Score * 100))%</span>
                        <span style="width:52px;color:#64748b;font-size:0.5rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@factor.Source">@factor.Source</span>
                    </div>
                }
            </div>

            <!-- Canlı Trendler -->
            <div class="climate-chart-card">
                <div class="chart-title" data-tip="Küresel iklim göstergelerinin güncel değerleri (NOAA/NASA kaynaklı). CO₂ konsantrasyonu, deniz seviyesi artış hızı ve sıcaklık anomalisi. Veriler statik dosyadan yüklenir, periyodik olarak güncellenir.">Küresel İklim Göstergeleri</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    @if (_trends?.co2 != null)
                    {
                        <div data-tip="@(_trends.co2.source): 1960'tan bugüne artış. Endüstriyel sürecin başladığı döneme göre %33+ artış. Her 2,4 ppm artış ~yıl başına. İklim Diplomasisi kritik eşiği 450 ppm.">
                            <div style="font-size:0.55rem;color:#64748b;margin-bottom:2px;">CO₂ Konsantrasyonu</div>
                            <div style="font-size:0.85rem;font-weight:700;color:#f44336;">@(_trends.co2.current_value.ToString("F2")) ppm</div>
                            <div style="font-size:0.5rem;color:#64748b;">@(_trends.co2.trend == "increasing" ? "↑ Artış" : _trends.co2.trend) · @(_trends.co2.annual_change_ppm?.ToString("F1") ?? "?") ppm/yıl</div>
                        </div>
                    }
                    @if (_trends?.sea_level != null)
                    {
                        <div data-tip="@(_trends.sea_level.source): 1993'ten bu yana toplam +@(_trends.sea_level.total_rise_since_1993_mm?.ToString("F0") ?? "101")mm yükselme. Hızlanan trend: eriyen buzul ve termal genleşme. Kıyı tesisleri için doğrudan tehdit.">
                            <div style="font-size:0.55rem;color:#64748b;margin-bottom:2px;">Deniz Seviyesi Artışı</div>
                            <div style="font-size:0.85rem;font-weight:700;color:#ff9800;">+@(_trends.sea_level.current_rate_mm_per_year?.ToString("F1") ?? "3.6") mm/yıl</div>
                            <div style="font-size:0.5rem;color:#64748b;">@(_trends.sea_level.trend == "accelerating" ? "↑ Hızlanan" : _trends.sea_level.trend) · 1993'ten beri toplam +@(_trends.sea_level.total_rise_since_1993_mm?.ToString("F0") ?? "101")mm</div>
                        </div>
                    }
                    @if (_trends?.temperature_anomaly != null)
                    {
                        <div data-tip="@(_trends.temperature_anomaly.source): 1850-1900 temeline göre sapma. Paris Anlaşması hedefi: 1,5°C altında tutmak. 1,45°C → hedefe çok yaklaşıldı. Sıcak dalgası, kuraklık ve sel olaylarını doğrudan etkiler.">
                            <div style="font-size:0.55rem;color:#64748b;margin-bottom:2px;">Ort. Sıcaklık Anomalisi</div>
                            <div style="font-size:0.85rem;font-weight:700;color:#f44336;">+@(_trends.temperature_anomaly.current_value.ToString("F2")) °C</div>
                            <div style="font-size:0.5rem;color:#64748b;">@(_trends.temperature_anomaly.trend == "increasing" ? "↑ Artış" : _trends.temperature_anomaly.trend) · 1850-1900 temeline göre</div>
                        </div>
                    }
                    @if (_trends?.ice_mass != null)
                    {
                        <div style="border-top:1px solid #1e293b;padding-top:6px;margin-top:2px;" data-tip="Grönland ve Antarktika buzul kütlelerinin yıllık kayıp hızı. Eriyen buzullar deniz seviyesi yükselmesinin ana nedenlerinden biri.">
                            <div style="font-size:0.55rem;color:#64748b;margin-bottom:2px;">Buzul Kütlesi Kaybı</div>
                            <div style="font-size:0.7rem;color:#a78bfa;">
                                🏔️ Grönland: @_trends.ice_mass.greenland?.loss_rate Gt/yıl
                                <span style="font-size:0.5rem;color:#64748b;">(@(_trends.ice_mass.greenland?.trend == "accelerating_loss" ? "hızlanan" : _trends.ice_mass.greenland?.trend))</span>
                            </div>
                            <div style="font-size:0.7rem;color:#a78bfa;">
                                🧊 Antarktika: @_trends.ice_mass.antarctica?.loss_rate Gt/yıl
                                <span style="font-size:0.5rem;color:#64748b;">(@(_trends.ice_mass.antarctica?.trend == "accelerating_loss" ? "hızlanan" : _trends.ice_mass.antarctica?.trend))</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Senaryo Karşılaştırma -->
            @if (_scenarioResults != null && _scenarioResults.Count > 0)
            {
                <div class="climate-chart-card span-2">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                        <span style="font-size:0.7rem;text-transform:uppercase;color:#8b949e;letter-spacing:0.5px;" data-tip="Dört SSP senaryosunun her biri için ayrı ayrı hesaplanan fiziksel ve geçiş riski ile finansal etki. Farklı gelecek yollarının (sürdürülebilir → fosil) risk üzerindeki etkisini karşılaştırır.">📊 Senaryo Karşılaştırması</span>
                        <span style="padding:2px 6px;border-radius:4px;background:rgba(168,130,255,0.15);color:#a882ff;font-size:0.6rem;">4 Senaryo</span>
                    </div>
                    <div class="scenario-grid">
                        @foreach (var result in _scenarioResults)
                        {
                            <div class="scenario-item">
                                <div class="scenario-label">@result.Scenario</div>
                                <div class="scenario-risk">
                                    <span class="risk-physical">Fiziksel: @result.Assessment.PhysicalRisk.ToString("P1")</span>
                                    <span class="risk-transition">Geçiş: @result.Assessment.TransitionRisk.ToString("P1")</span>
                                </div>
                                <div class="scenario-decision">
                                    <span class="intent-badge @GetDecisionClass(result.Assessment.Decision)">
                                        @GetDecisionIcon(result.Assessment.Decision) @result.Assessment.Decision
                                    </span>
                                </div>
                                @if (result.Impact != null && result.Impact.NetCashFlowImpact != 0)
                                {
                                    <div class="scenario-financial @(result.Impact.NetCashFlowImpact < 0 ? "negative" : "positive")">
                                        @FormatCurrency(result.Impact.NetCashFlowImpact)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Finansal Etki Analizi -->
            @if (_assessment?.FinancialImpact != null && _assessment.FinancialImpact.CategoryImpacts.Any())
            {
                <div class="climate-chart-card span-2">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                        <span style="font-size:0.7rem;text-transform:uppercase;color:#8b949e;letter-spacing:0.5px;" data-tip="Fiziksel ve geçiş riskinin şirketin finansal kalemlerine (gelir, operasyonel gider, yatırım) parasal yansıması. Net nakit akışı kaybı büyükse Intentum kararını bir kademe sıkılaştırır.">💰 Finansal Etki Analizi</span>
                        <span class="net-cash-flow @(_assessment.FinancialImpact.NetCashFlowImpact < 0 ? "negative" : "positive")">
                            Net Nakit Akışı: @FormatCurrency(_assessment.FinancialImpact.NetCashFlowImpact)
                        </span>
                    </div>
                    @{
                        var net = _assessment.FinancialImpact.NetCashFlowImpact;
                    }
                    @if (net <= -10_000_000)
                    {
                        <div style="font-size:0.62rem;color:#fbbf24;background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.3);border-radius:6px;padding:6px 8px;margin-bottom:8px;">
                            ⚠️ Bu finansal maruziyet Intentum kararını <strong>sıkılaştırdı</strong> — net kayıp @($"{(net <= -25_000_000 ? "REJECT" : "REVIEW")}") seviyesini tetikledi.
                        </div>
                    }
                    <div class="impact-categories">
                        @foreach (var cat in _assessment.FinancialImpact.CategoryImpacts)
                        {
                            <div class="impact-category">
                                <div class="impact-category-label">@GetCategoryLabel(cat.Type)</div>
                                <div class="impact-category-bar">
                                    <div class="impact-bar physical @(cat.PhysicalImpact < 0 ? "negative" : "positive")"
                                         style="width: @GetBarWidth(cat.PhysicalImpact, _assessment.FinancialImpact);min-width:@(cat.PhysicalImpact != 0 ? "8px" : "0");"></div>
                                    <div class="impact-bar transition @(cat.TransitionImpact < 0 ? "negative" : "positive")"
                                         style="width: @GetBarWidth(cat.TransitionImpact, _assessment.FinancialImpact);min-width:@(cat.TransitionImpact != 0 ? "8px" : "0");"></div>
                                </div>
                                <div class="impact-category-total @(cat.TotalImpact < 0 ? "negative" : "positive")">
                                    @FormatCurrency(cat.TotalImpact)
                                </div>
                            </div>
                        }
                    </div>
                    <div class="impact-legend">
                        <span class="legend-item"><span class="legend-dot physical"></span> Fiziksel Risk</span>
                        <span class="legend-item"><span class="legend-dot transition"></span> Geçiş Riski</span>
                    </div>
                </div>
            }

            <!-- IPCC Risk Matrix: Tehlike × Varlık & Tehlike × Senaryo -->
            @if (_assessment.HazardExposureMatrix != null || _assessment.ScenarioMatrix != null)
            {
                <div class="climate-chart-card span-2">
                    <div class="chart-title" data-tip="IPCC risk çerçevesi: Risk = Tehlike × Maruziyet × Kırılganlık. Solda tehlikelerin şirket varlıkları üzerindeki bileşik riski, sağda ise her SSP senaryosunun tehlikeler üzerindeki etkisi hücre hücre görünür.">📊 İklim Risk Matrix — Tehlike × (Varlık / Senaryo)</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        @if (_assessment.HazardExposureMatrix != null)
                        {
                            <div style="min-width:0;">
                                <div style="font-size:0.65rem;color:#94a3b8;margin-bottom:6px;" data-tip="Her iklim tehlikesi (sıcaklık, yağış, su stresi, sel…) ile şirket varlık kategorisi (gelir, operasyon, yatırım) kesişimindeki bileşik risk skoru.">🔥 Tehlike × Varlık</div>
                                <div id="climate-hazard-exposure" class="chart-container" style="height:280px;"></div>
                            </div>
                        }
                        @if (_assessment.ScenarioMatrix != null)
                        {
                            <div style="min-width:0;">
                                <div style="font-size:0.65rem;color:#94a3b8;margin-bottom:6px;" data-tip="Her iklim tehlikesi ile her senaryo (SSP1-2.6 … SSP5-8.5) kesişimindeki bileşik risk. Senaryo ne kadar agresifse risk hücreleri o kadar kırmızılaşır.">📈 Tehlike × Senaryo</div>
                                <div id="climate-scenario-heat" class="chart-container" style="height:280px;"></div>
                            </div>
                        }
                    </div>
                    <div style="font-size:0.58rem;color:#94a3b8;margin-top:8px;line-height:1.4;">
                        Risk = Tehlike (İklim) × Maruziyet (Değer) × Kırılganlık (Hassasiyet / Uyum Kapasitesi). Senaryo matrix'i her SSP senaryosunun tehlikeler üzerindeki bileşik riskini gösterir.
                    </div>
                </div>
            }

            <!-- Bütün Sistemden Etkilenecek Şeyler -->
            @if (_assessment?.SystemImpact != null)
            {
                <div class="climate-chart-card span-2">
                    <div class="chart-title" data-tip="İklim risk analizinin şirketin tüm sistemlerine (operasyon, tedarik zinciri, finans, İK, altyapı, paydaşlar, BT) yayılacak etkileri. Her kategori risk seviyesine göre filtrelenmiştir.">Bütün Sistemden Etkilenecek Şeyler</div>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;">
                        <span style="padding:3px 7px;border-radius:999px;background:#1e293b;color:#e2e8f0;font-size:0.6rem;">Toplam @_assessment.SystemImpact.TotalImpacts etki</span>
                        @if (_assessment.SystemImpact.CriticalCount > 0)
                        {
                            <span style="padding:3px 7px;border-radius:999px;background:#7f1d1d;color:#fca5a5;font-size:0.6rem;">@_assessment.SystemImpact.CriticalCount kritik</span>
                        }
                        @if (_assessment.SystemImpact.HighCount > 0)
                        {
                            <span style="padding:3px 7px;border-radius:999px;background:#78350f;color:#fde68a;font-size:0.6rem;">@_assessment.SystemImpact.HighCount yüksek</span>
                        }
                    </div>
                    <div style="font-size:0.65rem;color:#94a3b8;margin-bottom:10px;background:#0f172a;border:1px solid #1e293b;border-radius:6px;padding:7px;">
                        @_assessment.SystemImpact.Summary
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:8px;">
                        @foreach (var cat in _assessment.SystemImpact.Categories)
                        {
                            <div style="background:#0f172a;border:1px solid #1e293b;border-radius:8px;padding:8px;">
                                <div style="font-weight:700;font-size:0.65rem;color:#e2e8f0;margin-bottom:6px;display:flex;align-items:center;gap:6px;">
                                    <span>@cat.Icon</span> @cat.Name
                                    <span style="font-size:0.5rem;color:#64748b;font-weight:400;">(@cat.Items.Count)</span>
                                </div>
                                @foreach (var item in cat.Items)
                                {
                                    var urgencyColor = item.Urgency switch
                                    {
                                        "CRITICAL" => "#ef4444",
                                        "HIGH" => "#f59e0b",
                                        "MEDIUM" => "#3b82f6",
                                        _ => "#22c55e"
                                    };
                                    <div style="font-size:0.55rem;color:#cbd5e1;padding:4px 0 4px 6px;border-left:2px solid @urgencyColor;margin-bottom:4px;line-height:1.35;" title="Tetikleyici: @item.Trigger | Zamanlama: @item.Timeline">
                                        <span style="font-weight:600;color:@urgencyColor;">[@item.Urgency]</span> @item.Description
                                        <div style="font-size:0.5rem;color:#64748b;margin-top:2px;">⏱ @item.Timeline · 📌 @item.Trigger</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Politika Kararı (en altta, tam genişlik) -->
            <div class="climate-chart-card span-2">
                <div class="chart-title" data-tip="Intentum'un davranış uzayından çıkardığı niyet ve güven seviyesine göre verilen nihai karar (ALLOW/REVIEW/REJECT). Altında kararın nedenleri, önerileri ve sinyalleri ayrıntılı olarak açıklanır.">Politika Karari (Intentum)</div>
                <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:8px;">
                    <span style="padding:4px 8px;border-radius:6px;background:@GetPolicyColor();color:white;font-weight:700;font-size:0.85rem;">@GetPolicyDecision()</span>
                    <span style="padding:3px 7px;border-radius:999px;background:#1e293b;color:#e2e8f0;font-size:0.6rem;border:1px solid #334155;">@_assessment.IntentName</span>
                    <span style="padding:3px 7px;border-radius:999px;background:#0f172a;color:#38bdf8;font-size:0.6rem;border:1px solid #0ea5e9;">Güven @_assessment.ConfidenceLevel @_assessment.ConfidenceScore.ToString("F2")</span>
                    <span style="padding:3px 7px;border-radius:999px;background:@(_assessment.IsCoastal ? "#064e3b" : "#1e1b4b");color:@(_assessment.IsCoastal ? "#6ee7b7" : "#a5b4fc");font-size:0.55rem;">@(_assessment.IsCoastal ? "Kıyı" : "İç Bölge") · @_assessment.EffectiveSeaLevel.ToString("F1")m efektif</span>
                    <span style="padding:3px 7px;border-radius:999px;background:@GetDataConfidenceColor();color:white;font-size:0.6rem;" data-tip="Veri yeterlilik skoru: kaynakların mevcudiyetine göre hesaplanır. Düşük skor REVIEW kararını tetikler.">Veri @((_assessment.DataConfidence * 100).ToString("F0"))%</span>
                    @if (_assessment.ClimateRegion != null)
                    {
                        <span style="padding:3px 7px;border-radius:999px;background:#312e81;color:#c4b5fd;font-size:0.55rem;border:1px solid #6366f1;" data-tip="@_assessment.ClimateRegion.Name — @_assessment.ClimateRegion.ClimateType bölgesel adaptasyon önerileri">🌍 @_assessment.ClimateRegion.Name</span>
                    }
                    @if (_assessment.IsRegionalEstimate)
                    {
                        <span style="padding:3px 7px;border-radius:999px;background:#78350f;color:#fde68a;font-size:0.55rem;border:1px solid #b45309;">⚠️ Bölgesel Tahmin</span>
                    }
                </div>
                <div style="font-size:0.68rem;color:#e2e8f0;line-height:1.45;margin-bottom:8px;background:#0f172a;border:1px solid #1e293b;border-radius:6px;padding:8px;">
                    @_assessment.DecisionSummary
                </div>
                <div style="font-size:0.6rem;color:#93c5fd;background:#0b1220;border:1px dashed #1e3a5f;border-radius:6px;padding:7px;margin-bottom:8px;">
                    <strong>Coğrafi not:</strong> @_assessment.CoastalInfo<br/>
                    <span style="color:#64748b;">@(_selectedProfile?.Name ?? _input.LocationName) @(_assessment.Input.RadiusKm)km yarıçap — @( _assessment.IsCoastal ? "kıyı taşkını potensiyeli var" : "denize ulaşmıyor, dolaylı riskler izlenir")</span>
                </div>
                <details open style="margin-bottom:6px;">
                    <summary style="cursor:pointer;font-size:0.65rem;font-weight:600;color:#cbd5e1;list-style:none;display:flex;align-items:center;gap:6px;">▸ Nedenleri (@_assessment.DecisionReasons.Count)</summary>
                    <div style="margin-top:6px;">
                    @foreach (var reason in _assessment.DecisionReasons)
                    {
                        <div style="font-size:0.6rem;color:#cbd5e1;padding:3px 0 3px 8px;border-left:2px solid @GetPolicyColor();margin-bottom:3px;line-height:1.35;">
                            @reason
                        </div>
                    }
                    </div>
                </details>
                <details style="margin-bottom:6px;">
                    <summary style="cursor:pointer;font-size:0.65rem;font-weight:600;color:#86efac;list-style:none;">▸ Öneriler (@_assessment.RecommendedActions.Count)</summary>
                    <div style="margin-top:6px;">
                    @foreach (var action in _assessment.RecommendedActions)
                    {
                        <div style="font-size:0.6rem;color:#bbf7d0;padding:3px 0 3px 8px;border-left:2px solid #22c55e;margin-bottom:2px;line-height:1.35;">
                            @action
                        </div>
                    }
                    </div>
                </details>
                <details>
                    <summary style="cursor:pointer;font-size:0.65rem;font-weight:600;color:#fbbf24;list-style:none;">▸ Intentum Sinyalleri (@_assessment.Signals.Count sinyal) — @_assessment.IntentReasoning</summary>
                    <div style="margin-top:8px;">
                    @foreach (var category in _assessment.Signals.GroupBy(s => ClimateRiskIntentModel.SignalCategories.GetValueOrDefault(s.Source, "Diğer")).OrderBy(g => g.Key))
                    {
                        <div style="margin-bottom:8px;">
                            <div style="font-size:0.6rem;font-weight:700;color:@GetSignalCategoryColor(category.First().Source);margin-bottom:4px;display:flex;align-items:center;gap:6px;">
                                <span style="width:8px;height:8px;border-radius:50%;background:@GetSignalCategoryColor(category.First().Source);display:inline-block;"></span>
                                @category.Key (@category.Count())
                            </div>
                            @foreach (var sig in category.OrderByDescending(s => s.Weight))
                            {
                                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;font-size:0.55rem;padding-left:14px;" title="@GetSignalTooltip(sig.Source, sig.Weight)">
                                    <span style="width:120px;color:#cbd5e1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@sig.Description</span>
                                    <div style="flex:1;height:5px;background:#1e293b;border-radius:3px;overflow:hidden;">
                                        <div style="height:100%;width:@(Math.Min(sig.Weight*100,100))%;background:@GetSignalCategoryColor(sig.Source);border-radius:3px;"></div>
                                    </div>
                                    <span style="width:32px;color:#94a3b8;font-weight:600;">@sig.Weight.ToString("F2")</span>
                                </div>
                            }
                        </div>
                    }
                    </div>
                </details>
                <div style="font-size:0.5rem;color:#475569;margin-top:6px;">BehaviorSpace · @(_assessment.Signals.Sum(s=>s.Weight).ToString("F2")) ağırlık · Policy: @GetPolicyDecision() via Intentum.Runtime.Engine</div>
            </div>
        }
    </div>
    </div>
</div>

<CompanyProfileDrawer IsOpen="@_drawerOpen"
                      Profile="@_editingProfile"
                      IsNew="@_isNewProfile"
                      IsOpenChanged="@((bool v) => _drawerOpen = v)"
                      OnSave="@HandleProfileSave" />
