<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Intentum.AI.SystemOne</PackageId>
    <Authors>Intentum Contributors</Authors>
    <Description>System One (Jev-compatible) HTTP adapter for Intentum. Works with Kev, Laya, TinyJev, OpenDecision, NanoJev, OpenJevPro and any server speaking POST /v1/systemone.</Description>
    <PackageTags>intent;behavior;ai;system-one;jev;kev;laya;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/keremvaris/Intentum</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intentum.Core\Intentum.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kendi package-specific README'imizi paketliyoruz; kök README ile duplicate dosya oluşmasın
         (NuGet push'u duplicate README.md nedeniyle reddediyordu). -->
    <None Remove="$(RepoReadmePath)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
